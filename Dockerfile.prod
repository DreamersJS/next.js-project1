FROM node:20-bullseye-slim

WORKDIR /app

COPY server/package*.json ./server/

WORKDIR /app/server
RUN npm ci --omit=dev

COPY server/ ./


ARG CLIENT_ORIGIN

ENV PORT=3000
ENV NODE_ENV=production
ENV CLIENT_ORIGIN=$CLIENT_ORIGIN

EXPOSE 3000
CMD ["npm", "run", "server"]
# docker build -f Dockerfile.prod -t whiteboard-backend .